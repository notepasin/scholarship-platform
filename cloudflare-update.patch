+test('partner endpoint requires its own bearer key and returns correlation evidence without private data',async()=>{const env=environment(),bound={...env,DB:env.db};const url='https://test.local/api/partner/scholarships';assert.equal((await handleProvider(new Request(url),bound)).status,401);const r=await handleProvider(new Request(url,{headers:{Authorization:`Bearer ${env.PARTNER_API_KEY}`}}),bound);assert.equal(r.status,200);const data=await r.json();assert.equal(data.provider,'group15-scholarship');assert.equal(data.data.length,4);assert.equal(r.headers.get('x-request-id'),data.request_id);assert.equal(env.sqlite.prepare('SELECT id FROM provider_access_logs').get().id,data.request_id);assert.doesNotMatch(JSON.stringify(data),/password_hash|auth_sessions|unit-test-only-service/);});
+test('partner missing config fails closed and non-GET requests cannot mutate business data',async()=>{const env=environment();assert.equal((await handleProvider(new Request('https://test.local/api/partner/scholarships'),{...env,DB:env.db,PARTNER_API_KEY:undefined})).status,503);assert.equal((await handleProvider(req('partner/scholarships',{}),{...env,DB:env.db})).status,405);});
