+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {database} from './helpers.mjs';
+import {handleAuth,sessionUser,sha256,hashPassword} from '../lib/auth.mjs';
+import {handleProvider} from '../lib/provider.mjs';
+const pepper='unit-test-only-pepper-not-a-real-secret-000000';
+function environment(){return {...database(),AUTH_PEPPER:pepper,REGISTRATION_ENABLED:'true',PARTNER_API_KEY:'unit-test-only-service-key-000000000000'};}
+const credentials={username:'student_one',password:'classroom-test-only-2026'};
+function req(path,body,options={}){return new Request('https://test.local/api/'+path,{method:options.method||'POST',headers:{Origin:'https://test.local','Content-Type':'application/json',...options.headers},...(body!==undefined?{body:JSON.stringify(body)}:{})});}
+async function register(env,options={}){return handleAuth(req('auth/register',credentials,options),{...env,DB:env.db});}
+test('registration stores salted peppered password hashes and only a hash of the session token',async()=>{const env=environment();const r=await register(env);assert.equal(r.status,201);const cookie=r.headers.get('set-cookie');assert.match(cookie,/HttpOnly/);assert.match(cookie,/Secure/);assert.match(cookie,/SameSite=Lax/);assert.match(cookie,/__Host-/);const account=env.sqlite.prepare('SELECT * FROM auth_accounts').get();assert.notEqual(account.password_hash,credentials.password);assert.equal(account.password_hash.length,64);assert.equal(account.salt.length,64);const token=cookie.split(';')[0].split('=')[1];assert.equal(env.sqlite.prepare('SELECT token_hash FROM auth_sessions').get().token_hash,await sha256(token));const user=await sessionUser(env.db,cookie);assert.equal(user.username,credentials.username);});
+test('login succeeds with correct password and rejects wrong/nonexistent credentials',async()=>{const env=environment();await register(env);const run=c=>handleAuth(req('auth/login',c),{...env,DB:env.db});assert.equal((await run(credentials)).status,200);assert.equal((await run({...credentials,password:'incorrect-password-2026'})).status,401);assert.equal((await run({...credentials,username:'unknown'})).status,401);});
+test('sessions expire, unknown tokens and forged identity headers do not grant a session',async()=>{const env=environment();const r=await register(env),cookie=r.headers.get('set-cookie');env.sqlite.exec('UPDATE auth_sessions SET expires_at=0');assert.equal(await sessionUser(env.db,cookie),null);assert.equal(await sessionUser(env.db,'__Host-scholarship_session='+'a'.repeat(64)),null);assert.equal(await sessionUser(env.db,'oai-authenticated-user-id=admin'),null);});
+test('logout deletes current server session and expires browser cookie',async()=>{const env=environment(),r=await register(env),cookie=r.headers.get('set-cookie');const out=await handleAuth(req('auth/logout',{}, {headers:{cookie}}),{...env,DB:env.db});assert.equal(out.status,200);assert.match(out.headers.get('set-cookie'),/Max-Age=0/);assert.equal(await sessionUser(env.db,cookie),null);});
+test('cross-origin authentication, short passwords, insecure remote transport and disabled registration fail closed',async()=>{const env=environment();assert.equal((await register(env,{headers:{Origin:'https://evil.example'}})).status,403);assert.equal((await handleAuth(req('auth/register',{...credentials,password:'short'}),{...env,DB:env.db})).status,400);assert.equal((await register({...env,REGISTRATION_ENABLED:'false'})).status,403);const insecure=new Request('http://remote.example/api/auth/login',{method:'POST',headers:{Origin:'http://remote.example','Content-Type':'application/json'},body:JSON.stringify(credentials)});assert.equal((await handleAuth(insecure,{...env,DB:env.db})).status,400);});
